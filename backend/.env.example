# Copy this file to .env and fill in the values. Never commit .env.

DATABASE_URL=postgresql+psycopg://voter:voter@localhost:5433/voter_analysis

# Google Gemini (free tier at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Cloudflare R2 (dashboard -> R2 -> Manage API Tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=voter-pdfs

# Extraction
RENDER_DPI=200
LLM_WORKERS=4
LLM_CACHE_DIR=.cache/llm

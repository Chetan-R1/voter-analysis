# Copy this file to .env and fill in the values. Never commit .env.

DATABASE_URL=postgresql+psycopg://voter:voter@localhost:5433/voter_analysis

# Google Gemini (free tier at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Cloudflare R2 (dashboard -> R2 -> Manage API Tokens)
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET=your_bucket_name_here

# Extraction
RENDER_DPI=200
LLM_WORKERS=
LLM_CACHE_DIR=
